# APK/IPA: URL da API acessível pelo dispositivo. Expo Go usa o proxy local do Metro.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8080/api/v1
APP_VARIANT=development
# Produção: URL HTTPS da API. Esta variável é pública, nunca coloque segredos aqui.

# Se a API não usar Docker/8080, configure o destino LOCAL do proxy de desenvolvimento:
# EXPO_API_PROXY_TARGET=http://127.0.0.1:3000

# APK Android: chave Maps SDK for Android, restrita ao pacote e certificado do app.
# GOOGLE_MAPS_ANDROID_KEY=

# Túnel de desenvolvimento da SUA conta Ngrok (privado; nunca usar EXPO_PUBLIC_).
# NGROK_AUTHTOKEN=
