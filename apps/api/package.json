{
  "name": "@solution/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsc && concurrently -k \"tsc --watch --preserveWatchOutput\" \"node --watch dist/src/main.js\"",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "tsc && node --test --test-isolation=none dist/test/unit/*.test.js",
    "test:integration": "tsc && node --test --test-isolation=none --test-concurrency=1 dist/test/integration/*.test.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "provision": "tsx scripts/provision.ts",
    "seed:demo": "tsx scripts/seed-demo.ts",
    "openapi": "tsc && node dist/scripts/openapi.js",
    "seed:deliveries": "node --import tsx scripts/seed-deliveries.ts",
    "seed:investors": "tsx scripts/seed-investors.ts",
    "finance:work": "tsx scripts/finance-worker.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.7",
    "@nestjs/core": "11.2.7",
    "@nestjs/platform-express": "11.2.7",
    "@nestjs/swagger": "11.4.7",
    "@prisma/client": "7.10.0",
    "@prisma/adapter-pg": "7.10.0",
    "argon2": "0.44.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "cookie-parser": "1.4.7",
    "dotenv": "17.4.2",
    "ioredis": "5.11.1",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5",
    "decimal.js": "10.6.0",
    "helmet": "8.3.0"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/cookie-parser": "1.4.10",
    "@types/node": "24.19.1",
    "@types/pg": "8.23.1",
    "prisma": "7.10.0",
    "tsx": "4.23.15",
    "supertest": "7.3.1",
    "@types/supertest": "6.0.3",
    "concurrently": "9.2.4"
  },
  "files": [
    "dist/src",
    "dist/scripts",
    "prisma",
    "prisma.config.ts"
  ],
  "engines": {
    "node": "24.x"
  }
}
