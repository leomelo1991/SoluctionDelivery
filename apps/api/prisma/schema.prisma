generator client {
 provider = "prisma-client"
 output = "../src/generated/prisma"
}
datasource db {
 provider = "postgresql"
}
enum Role {
 admin
 establishment
 courier
}
enum DeliveryStatus {
 waiting
 assigned
 accepted
 arrived
 collected
 delivered
}
model Tenant {
 id String @id @default(uuid()) @db.Uuid
 slug String @unique
 name String
 active Boolean @default(true)
 routingPrimary String @default("mapbox")
 routingFallback Boolean @default(true)
 createdAt DateTime @default(now())
}
model User {
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid
 name String
 email String
 passwordHash String
 role Role
 establishmentId String? @db.Uuid
 courierId String? @db.Uuid
 active Boolean @default(true)
 mustChangePassword Boolean @default(true)
 createdAt DateTime @default(now())
 establishment Establishment? @relation(fields: [tenantId, establishmentId], references: [tenantId, id])
 courier Courier? @relation(fields: [tenantId, courierId], references: [tenantId, id])
 sessions Session[]
 @@unique([tenantId, id])
 @@unique([tenantId, email])
}
model Session {
 id String @id @default(uuid()) @db.Uuid
 tokenHash String @unique
 csrfToken String
 channel String @default("web")
 tenantId String @db.Uuid
 userId String @db.Uuid
 expiresAt DateTime
 createdAt DateTime @default(now())
 user User @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
 @@index([expiresAt])
}
model Establishment {
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid
 name String
 responsible String
 phone String
 email String
 city String
 address Json
 acquisitionChannel String @default("direct")
 lifecycleStatus String @default("lead")
 operationOpen Boolean @default(false)
 createdAt DateTime @default(now())
 users User[]
 deliveries Delivery[]
 notes CRMNote[]
 @@unique([tenantId, id])
 @@index([tenantId, lifecycleStatus])
}
model Courier {
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid
 name String
 phone String
 vehicle String
 approvalStatus String @default("pending")
 availabilityStatus String @default("offline")
 createdAt DateTime @default(now())
 users User[]
 deliveries Delivery[]
 offers DeliveryOffer[]
 @@unique([tenantId, id])
 @@index([tenantId, approvalStatus, availabilityStatus])
}
model Delivery {
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid
 code Int @default(autoincrement())
 establishmentId String @db.Uuid
 courierId String? @db.Uuid
 status DeliveryStatus @default(waiting)
 recipientName String
 recipientPhone String
 pickupAddress Json
 destinationAddress Json
 notes String @default("")
 pickupReady Boolean @default(false)
 manualDistanceM Int?
 distanceSource String?
 feeCents Int
 courierPayoutCents Int
 pricingSnapshot Json
 version Int @default(1)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 establishment Establishment @relation(fields: [tenantId, establishmentId], references: [tenantId, id])
 courier Courier? @relation(fields: [tenantId, courierId], references: [tenantId, id])
 offers DeliveryOffer[]
 events DeliveryEvent[]
 @@unique([tenantId, id])
 @@unique([tenantId, code])
 @@index([tenantId, establishmentId, status, createdAt])
 @@index([tenantId, courierId, status, createdAt])
 @@index([tenantId, status, createdAt])
 @@index([tenantId, establishmentId, status, updatedAt])
 @@index([tenantId, courierId, status, updatedAt])
 @@index([tenantId, status, updatedAt])
}
model DeliveryOffer {
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid
 deliveryId String @db.Uuid
 courierId String @db.Uuid
 status String @default("pending")
 origin String
 createdAt DateTime @default(now())
 respondedAt DateTime?
 delivery Delivery @relation(fields: [tenantId, deliveryId], references: [tenantId, id])
 courier Courier @relation(fields: [tenantId, courierId], references: [tenantId, id])
 @@unique([tenantId, deliveryId, courierId])
}
model DeliveryEvent {
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid
 deliveryId String @db.Uuid
 previousStatus DeliveryStatus?
 newStatus DeliveryStatus
 actorUserId String @db.Uuid
 origin String
 reason String?
 createdAt DateTime @default(now())
 delivery Delivery @relation(fields: [tenantId, deliveryId], references: [tenantId, id])
 @@index([tenantId, deliveryId, createdAt])
}
model CRMNote {
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid
 establishmentId String @db.Uuid
 authorUserId String @db.Uuid
 authorName String
 text String
 createdAt DateTime @default(now())
 establishment Establishment @relation(fields: [tenantId, establishmentId], references: [tenantId, id])
 @@index([tenantId, establishmentId, createdAt])
}
model AuditEvent {
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid
 actorUserId String? @db.Uuid
 entity String
 entityId String
 action String
 changes Json
 reason String?
 createdAt DateTime @default(now())
 @@index([tenantId, createdAt])
}
model PricingConfig {
 tenantId String @id @db.Uuid
 version Int @default(1)
 fee Json
 payout Json
 updatedAt DateTime @updatedAt
}
model Region {
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid
 name String
 city String
 coverage String
 feeCents Int
 payoutCents Int
 active Boolean @default(true)
 version Int @default(1)
 @@unique([tenantId, id])
 @@unique([tenantId, name])
}
model Surcharge {
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid
 name String
 reason String
 feeFixedCents Int @default(0)
 feePercentBps Int @default(0)
 payoutFixedCents Int @default(0)
 payoutPercentBps Int @default(0)
 startsAt DateTime
 endsAt DateTime?
 active Boolean @default(true)
 version Int @default(1)
 @@unique([tenantId, id])
 @@index([tenantId, active, startsAt])
}
model Quote {
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid
 userId String @db.Uuid
 establishmentId String @db.Uuid
 inputHash String
 snapshot Json
 feeCents Int
 payoutCents Int
 expiresAt DateTime
 consumed Boolean @default(false)
 createdAt DateTime @default(now())
 @@index([tenantId, expiresAt])
}
model Idempotency {
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid
 userId String @db.Uuid
 key String
 command String
 inputHash String
 response Json
 createdAt DateTime @default(now())
 @@unique([tenantId, userId, key])
}
