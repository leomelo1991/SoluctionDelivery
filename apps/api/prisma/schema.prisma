generator client {
 provider = "prisma-client"
 output = "../src/generated/prisma"
}
datasource db {
 provider = "postgresql"
}
enum Role {
 admin
 establishment
 courier
}
enum DeliveryStatus {
 waiting
 assigned
 accepted
 arrived
 collected
 delivered
}
model Tenant {
 financeWorkspace FinanceWorkspace?
 id String @id @default(uuid()) @db.Uuid
 slug String @unique
 name String
 active Boolean @default(true)
 routingPrimary String @default("mapbox")
 routingFallback Boolean @default(true)
 createdAt DateTime @default(now())
}
model User {
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid
 name String
 email String
 passwordHash String
 role Role
 establishmentId String? @db.Uuid
 courierId String? @db.Uuid
 active Boolean @default(true)
 mustChangePassword Boolean @default(true)
 createdAt DateTime @default(now())
 establishment Establishment? @relation(fields: [tenantId, establishmentId], references: [tenantId, id])
 courier Courier? @relation(fields: [tenantId, courierId], references: [tenantId, id])
 financePermissions FinancePermission[]
 sessions Session[]
 @@unique([tenantId, id])
 @@unique([tenantId, email])
}
model Session {
 id String @id @default(uuid()) @db.Uuid
 tokenHash String @unique
 csrfToken String
 channel String @default("web")
 tenantId String @db.Uuid
 userId String @db.Uuid
 expiresAt DateTime
 createdAt DateTime @default(now())
 user User @relation(fields: [tenantId, userId], references: [tenantId, id], onDelete: Cascade)
 @@index([expiresAt])
}
model Establishment {
 externalOrders ExternalOrder[]
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid
 name String
 responsible String
 phone String
 email String
 city String
 address Json
 acquisitionChannel String @default("direct")
 lifecycleStatus String @default("lead")
 operationOpen Boolean @default(false)
 createdAt DateTime @default(now())
 users User[]
 deliveries Delivery[]
 financeWallet FinanceWallet?
 financeReservations FinanceReservation[]
 financeTopups FinanceTopup[]
 contracts MerchantContract[]
 notes CRMNote[]
 @@unique([tenantId, id])
 @@index([tenantId, lifecycleStatus])
}
model Courier {
 financeEarnings FinanceEarning[]
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid
 name String
 phone String
 vehicle String
 approvalStatus String @default("pending")
 availabilityStatus String @default("offline")
 createdAt DateTime @default(now())
 users User[]
 deliveries Delivery[]
 position CourierPosition?
 allocations CourierAllocation[]
 offers DeliveryOffer[]
 @@unique([tenantId, id])
 @@index([tenantId, approvalStatus, availabilityStatus])
}
model Delivery {
 externalOrders ExternalOrder[]
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid
 code Int @default(autoincrement())
 establishmentId String @db.Uuid
 courierId String? @db.Uuid
 status DeliveryStatus @default(waiting)
 recipientName String
 recipientPhone String
 pickupAddress Json
 destinationAddress Json
 notes String @default("")
 pickupReady Boolean @default(false)
 manualDistanceM Int?
 distanceSource String?
 feeCents Int
 courierPayoutCents Int
 pricingSnapshot Json
 version Int @default(1)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 establishment Establishment @relation(fields: [tenantId, establishmentId], references: [tenantId, id])
 courier Courier? @relation(fields: [tenantId, courierId], references: [tenantId, id])
 financeReservations FinanceReservation[]
 offers DeliveryOffer[]
 events DeliveryEvent[]
 @@unique([tenantId, id])
 @@unique([tenantId, code])
 @@index([tenantId, establishmentId, status, createdAt])
 @@index([tenantId, courierId, status, createdAt])
 @@index([tenantId, status, createdAt])
 @@index([tenantId, establishmentId, status, updatedAt])
 @@index([tenantId, courierId, status, updatedAt])
 @@index([tenantId, status, updatedAt])
}
model DeliveryOffer {
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid
 deliveryId String @db.Uuid
 courierId String @db.Uuid
 status String @default("pending")
 origin String
 createdAt DateTime @default(now())
 respondedAt DateTime?
 delivery Delivery @relation(fields: [tenantId, deliveryId], references: [tenantId, id])
 courier Courier @relation(fields: [tenantId, courierId], references: [tenantId, id])
 @@unique([tenantId, deliveryId, courierId])
}
model DeliveryEvent {
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid
 deliveryId String @db.Uuid
 previousStatus DeliveryStatus?
 newStatus DeliveryStatus
 actorUserId String @db.Uuid
 origin String
 reason String?
 createdAt DateTime @default(now())
 delivery Delivery @relation(fields: [tenantId, deliveryId], references: [tenantId, id])
 @@index([tenantId, deliveryId, createdAt])
}
model CRMNote {
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid
 establishmentId String @db.Uuid
 authorUserId String @db.Uuid
 authorName String
 text String
 createdAt DateTime @default(now())
 establishment Establishment @relation(fields: [tenantId, establishmentId], references: [tenantId, id])
 @@index([tenantId, establishmentId, createdAt])
}
model AuditEvent {
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid
 actorUserId String? @db.Uuid
 entity String
 entityId String
 action String
 changes Json
 reason String?
 createdAt DateTime @default(now())
 @@index([tenantId, createdAt])
}
model PricingConfig {
 tenantId String @id @db.Uuid
 version Int @default(1)
 fee Json
 payout Json
 updatedAt DateTime @updatedAt
}
model Region {
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid
 name String
 city String
 coverage String
 feeCents Int
 payoutCents Int
 active Boolean @default(true)
 version Int @default(1)
 @@unique([tenantId, id])
 @@unique([tenantId, name])
}
model Surcharge {
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid
 name String
 reason String
 feeFixedCents Int @default(0)
 feePercentBps Int @default(0)
 payoutFixedCents Int @default(0)
 payoutPercentBps Int @default(0)
 startsAt DateTime
 endsAt DateTime?
 active Boolean @default(true)
 version Int @default(1)
 @@unique([tenantId, id])
 @@index([tenantId, active, startsAt])
}
model Quote {
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid
 userId String @db.Uuid
 establishmentId String @db.Uuid
 inputHash String
 snapshot Json
 feeCents Int
 payoutCents Int
 expiresAt DateTime
 consumed Boolean @default(false)
 createdAt DateTime @default(now())
 @@index([tenantId, expiresAt])
}
model Idempotency {
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid
 userId String @db.Uuid
 key String
 command String
 inputHash String
 response Json
 createdAt DateTime @default(now())
 @@unique([tenantId, userId, key])
}

model MerchantContract {
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid
 establishmentId String @db.Uuid
 title String
 createdAt DateTime @default(now())
 establishment Establishment @relation(fields: [tenantId, establishmentId], references: [tenantId, id])
 versions ContractVersion[]
 @@unique([tenantId, id])
 @@index([tenantId, establishmentId])
}
model ContractVersion {
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid
 contractId String @db.Uuid
 number Int
 revision Int @default(1)
 status String @default("draft")
 effectiveFrom DateTime
 effectiveTo DateTime
 terms Json
 createdAt DateTime @default(now())
 proposedAt DateTime?
 acceptedAt DateTime?
 acceptedBy String? @db.Uuid
 acceptanceEvidence String?
 contract MerchantContract @relation(fields: [tenantId, contractId], references: [tenantId, id])
 financeSettlements FinanceSettlement[]
 financeReservations FinanceReservation[]
 shifts ScheduledShift[]
 @@unique([tenantId, id])
 @@unique([tenantId, contractId, number])
}
model ScheduledShift {
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid
 versionId String @db.Uuid
 templateIndex Int
 startsAt DateTime
 endsAt DateTime
 capacity Int
 status String @default("scheduled")
 createdAt DateTime @default(now())
 version ContractVersion @relation(fields: [tenantId, versionId], references: [tenantId, id])
 allocations CourierAllocation[]
 @@unique([tenantId, id])
 @@unique([tenantId, versionId, templateIndex, startsAt])
 @@index([tenantId, startsAt])
}
model CourierAllocation {
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid
 shiftId String @db.Uuid
 courierId String @db.Uuid
 position Int
 startsAt DateTime
 endsAt DateTime
 cancelledAt DateTime?
 cancellationReason String?
 createdAt DateTime @default(now())
 shift ScheduledShift @relation(fields: [tenantId, shiftId], references: [tenantId, id])
 courier Courier @relation(fields: [tenantId, courierId], references: [tenantId, id])
 attendance AttendanceEvent[]
 @@unique([tenantId, id])
 @@index([tenantId, courierId, startsAt])
}
model AttendanceEvent {
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid
 allocationId String @db.Uuid
 actorUserId String @db.Uuid
 attendedMinutes Int
 reason String
 createdAt DateTime @default(now())
 allocation CourierAllocation @relation(fields: [tenantId, allocationId], references: [tenantId, id])
 @@index([tenantId, allocationId, createdAt])
}

// Somente a última amostra; não armazena histórico de deslocamentos.
model CourierPosition {
 tenantId String @db.Uuid
 courierId String @db.Uuid
 latitude Float
 longitude Float
 accuracy Float
 observedAt DateTime
 receivedAt DateTime @default(now())
 courier Courier @relation(fields: [tenantId, courierId], references: [tenantId, id], onDelete: Cascade)
 @@id([tenantId, courierId])
 @@index([tenantId, observedAt])
}
model MapGeocode {
 tenantId String @db.Uuid
 addressHash String
 latitude Float?
 longitude Float?
 status String
 expiresAt DateTime
 @@id([tenantId, addressHash])
 @@index([tenantId, expiresAt])
}

// F2: ambiente financeiro explicitamente simulado, separado do operacional.
model FinanceWorkspace {
 tenantId String @id @db.Uuid
 mode String @default("sandbox")
 createdAt DateTime @default(now())
 tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
 permissions FinancePermission[]
 wallets FinanceWallet[]
 accounts LedgerAccount[]
 transactions LedgerTransaction[]
 settlements FinanceSettlement[]
 operations FinanceOperation[]
}
model FinancePermission {
 tenantId String @db.Uuid
 userId String @db.Uuid
 capability String @default("sandbox_manage")
 workspace FinanceWorkspace @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
 user User @relation(fields: [tenantId, userId], references: [tenantId, id])
 @@id([tenantId, userId])
}
model FinanceWallet {
 tenantId String @db.Uuid
 establishmentId String @db.Uuid
 enabled Boolean @default(true)
 createdAt DateTime @default(now())
 workspace FinanceWorkspace @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
 establishment Establishment @relation(fields: [tenantId, establishmentId], references: [tenantId, id])
 reservations FinanceReservation[]
 topups FinanceTopup[]
 @@id([tenantId, establishmentId])
}
model LedgerAccount {
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid
 code String
 kind String
 currency String @default("BRL")
 workspace FinanceWorkspace @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
 entries LedgerEntry[]
 @@unique([tenantId, id])
 @@unique([tenantId, code])
}
model LedgerTransaction {
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid
 source String
 status String @default("draft")
 description String
 actorId String @db.Uuid
 createdAt DateTime @default(now())
 workspace FinanceWorkspace @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
 entries LedgerEntry[]
 @@unique([tenantId, id])
 @@unique([tenantId, source])
}
model LedgerEntry {
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid
 transactionId String @db.Uuid
 accountId String @db.Uuid
 // Débito positivo, crédito negativo; soma da transação = zero.
 amount BigInt
 transaction LedgerTransaction @relation(fields: [tenantId, transactionId], references: [tenantId, id], onDelete: Cascade)
 account LedgerAccount @relation(fields: [tenantId, accountId], references: [tenantId, id], onDelete: Cascade)
 @@index([tenantId, accountId])
 @@unique([tenantId, transactionId, accountId])
}
model FinanceOperation {
 tenantId String @db.Uuid
 key String
 inputHash String
 response Json
 createdAt DateTime @default(now())
 workspace FinanceWorkspace @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
 @@id([tenantId, key])
}
model FinanceReservation {
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid
 establishmentId String @db.Uuid
 source String
 kind String
 amount BigInt
 consumed BigInt @default(0)
 status String @default("reserved")
 versionId String? @db.Uuid
 deliveryId String? @db.Uuid
 weekStart DateTime?
 snapshot Json
 createdAt DateTime @default(now())
 closedAt DateTime?
 wallet FinanceWallet @relation(fields: [tenantId, establishmentId], references: [tenantId, establishmentId], onDelete: Cascade, map: "reservation_wallet_fkey")
 establishment Establishment @relation(fields: [tenantId, establishmentId], references: [tenantId, id])
 version ContractVersion? @relation(fields: [tenantId, versionId], references: [tenantId, id])
 delivery Delivery? @relation(fields: [tenantId, deliveryId], references: [tenantId, id])
 @@unique([tenantId, id])
 @@unique([tenantId, source])
 @@index([tenantId, establishmentId, createdAt])
}
model FinanceTopup {
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid
 establishmentId String @db.Uuid
 reference String
 amount BigInt
 scenario String
 status String @default("pending")
 actorId String @db.Uuid
 createdAt DateTime @default(now())
 wallet FinanceWallet @relation(fields: [tenantId, establishmentId], references: [tenantId, establishmentId], onDelete: Cascade, map: "topup_wallet_fkey")
 establishment Establishment @relation(fields: [tenantId, establishmentId], references: [tenantId, id])
 receipt FinanceSandboxReceipt?
 task FinanceTask?
 events FinanceProviderEvent[]
 @@unique([tenantId, id])
 @@unique([tenantId, reference])
 @@index([tenantId, establishmentId, createdAt])
}
model FinanceTask {
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid
 topupId String @db.Uuid
 status String @default("pending")
 attempts Int @default(0)
 leaseToken String? @db.Uuid
 leaseUntil DateTime?
 nextAttemptAt DateTime @default(now())
 errorCode String?
 createdAt DateTime @default(now())
 topup FinanceTopup @relation(fields: [tenantId, topupId], references: [tenantId, id], onDelete: Cascade)
 @@unique([tenantId, topupId])
 @@index([tenantId, status, nextAttemptAt])
}
model FinanceProviderEvent {
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid
 topupId String @db.Uuid
 provider String @default("fake")
 environment String @default("sandbox")
 eventId String
 inputHash String
 outcome String
 createdAt DateTime @default(now())
 topup FinanceTopup @relation(fields: [tenantId, topupId], references: [tenantId, id], onDelete: Cascade)
 @@unique([tenantId, provider, environment, eventId])
}

// Estado durável do PSP falso, independente do lançamento financeiro local.
model FinanceSandboxReceipt {
 tenantId String @db.Uuid
 topupId String @db.Uuid
 outcome String
 topup FinanceTopup @relation(fields: [tenantId, topupId], references: [tenantId, id], onDelete: Cascade)
 @@id([tenantId, topupId])
}

// Demonstrativo fechado e obrigações independentes da movimentação bancária.
model FinanceSettlement {
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid
 establishmentId String @db.Uuid
 versionId String @db.Uuid
 weekStart DateTime
 total BigInt
 snapshot Json
 actorId String @db.Uuid
 createdAt DateTime @default(now())
 workspace FinanceWorkspace @relation(fields: [tenantId], references: [tenantId], onDelete: Cascade)
 version ContractVersion @relation(fields: [tenantId, versionId], references: [tenantId, id])
 earnings FinanceEarning[]
 @@unique([tenantId, id])
 @@unique([tenantId, versionId, weekStart])
 @@index([tenantId, establishmentId, createdAt])
}
model FinanceEarning {
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid
 settlementId String @db.Uuid
 courierId String @db.Uuid
 source String
 amount BigInt
 snapshot Json
 createdAt DateTime @default(now())
 settlement FinanceSettlement @relation(fields: [tenantId, settlementId], references: [tenantId, id], onDelete: Cascade)
 courier Courier @relation(fields: [tenantId, courierId], references: [tenantId, id])
 payouts FinancePayout[]
 @@unique([tenantId, id])
 @@unique([tenantId, source])
 @@index([tenantId, courierId, createdAt])
}
model FinancePayout {
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid
 earningId String @db.Uuid
 amount BigInt
 status String @default("pending")
 scenario String
 destination String
 actorId String @db.Uuid
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 earning FinanceEarning @relation(fields: [tenantId, earningId], references: [tenantId, id], onDelete: Cascade)
 @@unique([tenantId, id])
 @@index([tenantId, status, createdAt])
}

model ExternalOrder {
 id String @id @default(uuid()) @db.Uuid
 tenantId String @db.Uuid
 establishmentId String @db.Uuid
 provider String
 externalReference String
 mode String @default("demo")
 recipientName String
 recipientPhone String
 destinationAddress Json
 notes String
 deliveryId String? @unique @db.Uuid
 createdAt DateTime @default(now())
 establishment Establishment @relation(fields: [tenantId, establishmentId], references: [tenantId, id], map: "ExternalOrder_establishment_fkey")
 delivery Delivery? @relation(fields: [tenantId, deliveryId], references: [tenantId, id], onDelete: Cascade, map: "ExternalOrder_delivery_fkey")
 @@unique([tenantId, establishmentId, provider, externalReference], map: "ExternalOrder_source_key")
 @@index([tenantId, establishmentId, createdAt])
}
